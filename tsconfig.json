{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false
  },
  "include": [
    "promptfooconfig.ts",
    "promptfooconfig.plugin.ts",
    "promptfooconfig.selftest.ts",
    "providers/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": ["node_modules", "eval/results", ".promptfoo"]
}
